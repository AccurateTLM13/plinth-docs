{
  "theme_name": "Plinth",
  "theme_version": "1.1.3",
  "groups": [
    {
      "name": "Typography",
      "slug": "typography",
      "settings": [
        {
          "kind": "header",
          "text": "Fonts"
        },
        {
          "kind": "setting",
          "id": "type_primary_font",
          "type": "Font",
          "label": "Primary",
          "info": "",
          "default": "Space Grotesk, weight 500"
        }
      ]
    },
    {
      "name": "Logo",
      "slug": "logo",
      "settings": [
        {
          "kind": "setting",
          "id": "logo",
          "type": "Image",
          "label": "Logo image",
          "info": "",
          "default": ""
        },
        {
          "kind": "setting",
          "id": "logo_width",
          "type": "Slider",
          "label": "Desktop logo width",
          "info": "",
          "default": "140px",
          "range": "50–300px"
        },
        {
          "kind": "setting",
          "id": "logo_width_mobile",
          "type": "Slider",
          "label": "Mobile logo width",
          "info": "",
          "default": "100px",
          "range": "40–200px"
        },
        {
          "kind": "setting",
          "id": "favicon",
          "type": "Image",
          "label": "Favicon",
          "info": "Square image, at least 32 × 32 px.",
          "default": ""
